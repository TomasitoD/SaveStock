# Copia este archivo como .env:  cp .env.example .env
# El .env nunca se sube al repositorio (RD-10). Con estos valores de ejemplo el proyecto arranca;
# para mandar correos reales cambia las SMTP_*, y para la tasa de cambio pon tu clave real.

# Archivo SQLite del Core (la web y el enviador usan el mismo). Con Docker lo fija docker-compose.yml.
SAVESTOCK_DB_RUTA=datos/savestock.db
# Archivo SQLite del inventario. Con Docker lo fija docker-compose.yml.
SAVESTOCK_INVENTARIO_DB_RUTA=datos/inventario.db
# Carpeta de los archivos de los documentos. Con Docker es el volumen "documentos".
SAVESTOCK_DOCUMENTOS_RUTA=datos/documentos
# URL pública de la web, para armar los enlaces de los correos.
SAVESTOCK_URL_BASE=http://localhost:5080

# Administrador inicial: se crea activado al iniciar la web si no existe.
SAVESTOCK_ADMIN_CORREO=admin@example.com
SAVESTOCK_ADMIN_CONTRASENA=Admin12345
SAVESTOCK_ADMIN_NOMBRE=Administrador

# Servidor de correo (solo lo usa el enviador). Con estos valores el envío falla de forma controlada
# y los correos quedan Pendientes en la cola, de donde se pueden leer.
SMTP_HOST=smtp.example.com
SMTP_PUERTO=587
SMTP_USUARIO=usuario@example.com
SMTP_CONTRASENA=contrasena-de-aplicacion
SMTP_REMITENTE=usuario@example.com

# Clave de ExchangeRate-API (https://www.exchangerate-api.com) para el total en dólares de una orden.
# Con este valor de ejemplo, GET /api/ordenes/{id}/total-usd responde 503 con un mensaje claro y el
# resto del sistema funciona igual. Pon aquí tu clave real para obtener la tasa del día.
EXCHANGE_API_KEY=tu-clave-de-exchangerate-api
