<Project Sdk="Microsoft.NET.Sdk">

  <!-- El inventario puede usar el Core; el Core nunca referencia al inventario (RD-03). -->
  <ItemGroup>
    <ProjectReference Include="..\SaveStock.Core\SaveStock.Core.csproj" />
  </ItemGroup>

  <!-- IHostedService: crea la base del inventario al iniciar sin tocar el Program.cs ni el Core. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- AddHttpClient: registra el HttpClient del cliente de la tasa de cambio. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

</Project>
