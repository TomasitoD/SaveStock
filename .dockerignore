**/obj/

# Datos locales: las bases y los documentos viven en volúmenes
datos/
*.db
*.db-shm
*.db-wal

# Pruebas, documentación y archivos del editor que la aplicación no necesita
tests/
pruebas/
docs/
*.md
.vs/
.vscode/
.idea/
.DS_Store
